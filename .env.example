# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
# Supabase 대시보드 → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# (선택) 웹 푸시 공개키 — node scripts/gen-vapid.mjs 로 만든 공개키. 비밀키는 여기에 넣지 마세요.
VITE_VAPID_PUBLIC_KEY=

# (권장) 개인정보 처리방침에 보이는 운영자 정보 — 앱 화면(주소 #privacy)에 공개돼요
# 문의 연락처(이메일 등). 비워 두면 처리방침에 "연락처 입력 필요"로 보여요
VITE_PRIVACY_CONTACT=
# 운영자 이름 또는 별명 (개인정보 보호책임자)
VITE_OPERATOR_NAME=
# Supabase 프로젝트 지역 (대시보드 Project Settings → General → Region), 예: 싱가포르(ap-southeast-1)
VITE_DATA_REGION=
