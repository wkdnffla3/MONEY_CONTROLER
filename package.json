{
  "name": "ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:edge": "node tests/edge/push-notify.test.mjs",
    "test:sql": "node tests/sql/run.mjs",
    "test:e2e": "node tests/e2e/build.mjs && node --test --test-concurrency=2 \"tests/e2e/*.e2e.test.mjs\"",
    "test:e2e:setup": "playwright install --with-deps chromium",
    "test:all": "npm test && npm run test:edge && npm run test:e2e && npm run test:sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "vite": "^7.0.0"
  }
}
